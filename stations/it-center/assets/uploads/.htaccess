# GNCP Uploads Security Configuration
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|exe|sh|bat|cmd|pht)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
