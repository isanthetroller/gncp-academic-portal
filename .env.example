# ==============================================================================
# GNCP Academic & Enrollment Management Portal — Environment Configuration
# ==============================================================================
# Duplicate this file as '.env' and update the values for your specific environment.
# Never commit active credentials, production passwords, or API keys into version control.

# Application Environment (local, staging, production)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/systemtest

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gncp_portal
DB_USER=root
DB_PASS=

# Centralized Mail Dispatch (Gmail / Corporate SMTP)
GNCP_SMTP_HOST=smtp.gmail.com
GNCP_SMTP_PORT=587
GNCP_SMTP_USER=
GNCP_SMTP_PASS=
GNCP_FROM_EMAIL=no-reply@gncp.edu.ph
GNCP_FROM_NAME="GNCP Portal Administrator"

# Payment Gateway (PayMongo API Credentials)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Remote Deployment / FTP Settings (Optional for deployment tools)
FTP_HOST=
FTP_USER=
FTP_PASS=
REMOTE_ROOT=
